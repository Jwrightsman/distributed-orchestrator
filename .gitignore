__pycache__/
*.pyc
.venv/
output/
ledger.json
config.json
projects/
events.db
events.db-*
capability-shadow-health.db
capability-shadow-health.db-*
scripts/wan_results/
scripts/showcase_results/
scripts/demo_results/
# ...but keep the result logs themselves. They are the evidence behind the
# reliability numbers published in the README and docs/showcase-ceiling.md, and
# eval runs are committed for exactly the same reason. A few KB of JSONL is a
# cheap price for a claim someone can audit.
!scripts/showcase_results/
!scripts/showcase_results/*.jsonl

# Artifacts generated while banding corpus items. The bands themselves are
# committed in evals/prompts.json; the thousands of generated files behind
# them are not.
evals/banding/

# The Compose deployment's state directory (docker-compose.yml mounts ./data).
# config.json and events.db are already ignored by name above, but the lock and
# the trusted-alpha marker are not, and none of it belongs in the repository.
data/

# Left in the repository root by a full `py -m pytest -q` run. SQLite writes the
# -wal and -shm sidecars next to events.db (the events.db-* rule above), and the
# coordinator lock falls back to the working directory when MYCELIUM_STATE_DIR
# is unset, so it lands here rather than in the data/ directory ignored above.
.mycelium-coordinator.lock
