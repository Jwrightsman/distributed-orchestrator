{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "orchestrator",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-c",
        "import os, uvicorn; uvicorn.run('server:app', host='127.0.0.1', port=int(os.environ.get('PORT', '8000')))"
      ],
      "port": 8000,
      "autoPort": true
    },
    {
      "name": "showcase-output",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-m", "http.server", "8899",
        "--bind", "127.0.0.1",
        "--directory", "output"
      ],
      "port": 8899
    }
  ]
}
