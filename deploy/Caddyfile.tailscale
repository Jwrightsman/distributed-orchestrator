# Path A — private overlay (Tailscale). See docs/DEPLOY.md.
#
# Copy to /etc/caddy/Caddyfile, replace the hostname and tailnet IP, then:
#
#     sudo caddy validate --config /etc/caddy/Caddyfile
#     sudo systemctl reload caddy
#
# Certificate: `tailscale cert` writes a Let's Encrypt certificate for your
# tailnet name to the current directory. It is a publicly-trusted certificate,
# which matters more than it sounds like: a Mycelium worker trusts the certifi
# CA bundle and nothing else, and it builds its HTTP client with
# `trust_env=False`, so SSL_CERT_FILE cannot add a private CA to it. A
# self-signed certificate cannot be made to work on a worker. `tailscale cert`
# and Caddy's automatic issuance both produce certificates that already work.
#
# Reachability: the hostname selects the TLS/site identity; it does NOT restrict
# listening interfaces. The explicit bind below restricts listening to the
# configured tailnet address. Keep the application on 127.0.0.1:8000.
{
	# No public ACME issuance on this path — the certificate comes from
	# `tailscale cert` and is named explicitly in the site block.
	auto_https disable_redirects

	# Error logs can include request objects too. Omit sensitive fields there
	# as well as in access logs; do not enable debug or request-body logging.
	log default {
		format filter {
			request>uri delete
			request>headers delete
			resp_headers delete
		}
	}

	servers {
		timeouts {
			# Bounds a client that opens a connection and sends its request
			# line slowly. Deliberately the only inbound timeout set: the
			# worker holds GET /tasks/next open for 25 seconds waiting for
			# work, and the dashboard holds /ws/events open indefinitely.
			# A read or write timeout would break both.
			read_header 10s
			idle 5m
		}
	}
}

# Replace with your own tailnet name: `tailscale status --json | grep DNSName`
# gives it, and it always ends in .ts.net.
YOUR-HOST.YOUR-TAILNET.ts.net {
	# Replace with this server's literal `tailscale ip -4` address.
	# Optional IPv6: append its literal `tailscale ip -6` address on this line.
	# Never use 0.0.0.0, ::, or a hostname here. Recheck after device re-enrollment.
	bind YOUR-TAILNET-IPV4

	# Written by: tailscale cert YOUR-HOST.YOUR-TAILNET.ts.net
	tls /var/lib/caddy/YOUR-HOST.YOUR-TAILNET.ts.net.crt /var/lib/caddy/YOUR-HOST.YOUR-TAILNET.ts.net.key

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# The application's own ceiling on a worker result is 10 MiB
	# (execution/attempts.py: MAX_OUTPUT_BYTES = 10_485_760). This sits just
	# above it on purpose, so an oversized result is refused by the
	# coordinator with a protocol error the worker can act on, rather than by
	# the proxy with an opaque 413.
	request_body {
		max_size 12MB
	}

	reverse_proxy 127.0.0.1:8000 {
		# Longer than the 25s long poll on GET /tasks/next.
		transport http {
			dial_timeout 10s
			response_header_timeout 60s
		}
	}

	# Omit full URI and all request/response headers from logs. This covers
	# /v1/shares/{token}, encoded paths, queries, Referer/Location, cookies,
	# Authorization, X-Node-Secret/Session, X-Pitch-Key, X-Viewer-Key and
	# Idempotency-Key. Requests still forward those headers to the application.
	log {
		output file /var/log/caddy/mycelium.log
		format filter {
			request>uri delete
			request>headers delete
			resp_headers delete
		}
	}
}
